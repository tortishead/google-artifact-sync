# Copy to .env (chmod 600) and fill in. Variables set in the shell take precedence.
GMS_REPO_URL=https://bitbucket.example.com/scm/PROJ/repo.git
# Only needed when GMS_REPO_URL is an SSH URL.
# BITBUCKET_URL=https://bitbucket.example.com
# HTTP access token scoped to the repo, with write permission.
BITBUCKET_TOKEN=
